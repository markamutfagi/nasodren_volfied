# Bu dosyayı ".env.local" olarak kopyala ve kendi Supabase projenin
# değerlerini yapıştır (Project Settings → Data API).
# ".env.local" .gitignore'da olmalı — gerçek anahtarları commit etme.
#
# Not: "anon public" anahtarı tarayıcıya gömülmesi güvenli bir anahtardır
# (gizli/servis anahtarı DEĞİL). Gerçek yetkilendirme supabase/schema.sql
# içindeki Row Level Security kurallarıyla sağlanıyor.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
